# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Brevo transactional email API key (Brevo dashboard > SMTP & API > API Keys).
BREVO_API_KEY=

# Any long random string, used to sign the recipe unlock links. Generate one with:
# openssl rand -hex 32
# Changing this later invalidates every access link already sent out.
UNLOCK_SECRET=

# Used to build the access link inside the unlock email. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://darshmode.com
